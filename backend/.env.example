# Caminho do banco SQLite. O arquivo será criado na pasta backend/prisma.
DATABASE_URL="file:./dev.db"

# Troque por uma chave longa e aleatória antes de publicar em produção.
JWT_SECRET="substitua-por-uma-chave-secreta-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"
PORT=3333
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
